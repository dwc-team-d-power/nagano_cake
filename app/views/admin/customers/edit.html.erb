<div class="container">
  <div class="row">
    <div class="col">
      <h4 class="p-0.5 bg-secondary">
        <%= @customer.full_name %>さんの会員情報編集
      </h4>
      <%= form_with model: [:admin, @customer] do |f| %>
        <table class="table table-borderless">
          <tr>
            <td>会員ID</td>
            <td><%= @customer.id %></td>
          </tr>
          <tr>
            <td>氏名</td>
            <td>
              <%= f.text_field :last_name, class: "form-control" %> <%= f.text_field :first_name, class: "form-control" %>
            </td>
          </tr>
          <tr>
            <td>フリガナ</td>
            <td>
              <%= f.text_field :last_name_kana, class: "form-control" %> <%= f.text_field :first_name_kana, class: "form-control" %>
            </td>
          </tr>
          <tr>
            <td>郵便番号</td>
            <td><%= f.text_field :postal_code, class: "form-control" %></td>
          </tr>
          <tr>
            <td>住所</td>
            <td><%= f.text_field :address, class: "form-control" %></td>
          </tr>
          <tr>
            <td>電話番号</td>
            <td><%= f.number_field :telephone_number, class: "form-control" %></td>
          </tr>
          <tr>
            <td>メールアドレス</td>
            <td><%= f.email_field :email, class: "form-control" %></td>
          </tr>
          <tr>
            <td>会員ステータス</td>
            <td>
              <%= f.radio_button :is_active, true %>
              <%= f.label :is_active, "有効", value: true %>
              <%= f.radio_button :is_active, false %>
              <%= f.label :is_active, "退会", value: false %>
            </td>
          </tr>
          <tr>
            <td></td>
            <td><%= f.submit "変更を保存", class: "btn btn-success" %></td>
          </tr>
        </table>
      <% end %>
    </div>
  </div>
</div>
